{
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "dist",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "declaration": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [
      "node_modules",
      "dist",
      "tests",
      "src/index.ts",
      "src/auth-server.ts",
      "src/clients/quickbooks-oauth.ts"
    ]
}
